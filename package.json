{
  "name": "final-project-main",
  "version": "1. 0.0",
  "scripts": {
    "format:html": "prettier --write \"templates/**/*.html\"",
    "format:css": "prettier --write \"static/**/*.css\"",
    "format:all": "prettier --write \"**/*.{html,css}\" --ignore-path . gitignore",
    "lint:css": "stylelint \"static/**/*.css\"",
    "lint:css:fix": "stylelint \"static/**/*.css\" --fix",
    "lint:all": "npm run lint:css:fix && npm run format:all"
  },
  "devDependencies": {
    "@eslint/js": "^9. 39.1",
    "eslint": "^9.0. 0",
    "globals": "^15.0.0",
    "prettier": "^3. 0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
